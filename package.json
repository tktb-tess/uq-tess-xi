{
  "name": "uq-tess-xi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node .prebuilds/xml-generate.mts && vite build",
    "lbuild": "rm -rf .vercel && pnpm run build",
    "preview": "vite preview",
    "build-preview": "pnpm run lbuild && pnpm run preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest --run"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@shikijs/rehype": "^3.23.0",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tktb-tess/my-zod-schema": "^0.6.0",
    "@tktb-tess/util-fns": "^0.13.6",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jsdom": "^28.1.0",
    "lightningcss": "^1.33.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-to-hast": "^13.2.1",
    "neverthrow": "^8.2.0",
    "papaparse": "^5.6.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "redis": "^5.12.1",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "unified": "^11.0.5",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
